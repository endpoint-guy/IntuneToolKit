# ---------------------------------------------------------------------------
# EndpointGuy Intune Toolkit - module configuration
# Generated by Configure-Toolkit.ps1
# ---------------------------------------------------------------------------
@{
    Modules = @{
        CopyDeviceGroups     = $true;
        RemoveDeviceGroups   = $true;
        AssetStatus          = $true;
        BulkAddToGroup       = $true;
        BulkAssetStatus      = $true;
        AppDependencyCheck   = $true;
        DevicePrepCheck      = $true;
    };

    Branding = @{
        ToolkitName = 'EndpointGuy Intune Toolkit';
        WebsiteText = 'endpointguy.com';
        WebsiteUrl  = 'https://endpointguy.com1';
        LogoFile    = 'ToolkitLogo.png';
    };

    # Values are offered in this order and written verbatim to Intune Management Name.
    AssetStatusValues = @(
        'In Use'
        'Missing'
        'In Stock'
        'Retired'
        'Reserved'
        'Recycled'
        'Stolen'
        'Legalhold'
        'Lost'
    );
}
